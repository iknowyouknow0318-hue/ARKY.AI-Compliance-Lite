## 5. Database Schema & Supabase RLS Security

### SQL Schema (`server/src/db/schema.sql`)

```sql
-- 1. Users Table (Synced with Clerk user_id)
CREATE TABLE IF NOT EXISTS public.users (
  id TEXT PRIMARY KEY, -- Clerk user_id (e.g. 'user_2N...')
  email TEXT NOT NULL,
  company_name TEXT,
  industry TEXT,
  subscription_status TEXT DEFAULT 'active',
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 2. Policies Table
CREATE TABLE IF NOT EXISTS public.policies (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id TEXT NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
  title TEXT NOT NULL,
  framework TEXT NOT NULL, -- 'SOC 2', 'HIPAA', 'GDPR'
  category TEXT NOT NULL,
  content TEXT NOT NULL,
  version INT DEFAULT 1,
  status TEXT NOT NULL DEFAULT 'Published',
  compliance_tags JSONB DEFAULT '[]'::jsonb,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 3. Controls Table
CREATE TABLE IF NOT EXISTS public.controls (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id TEXT NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
  code TEXT NOT NULL, -- 'CC6.1', '164.312'
  title TEXT NOT NULL,
  framework TEXT NOT NULL,
  category TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'Not Started', -- 'Complete', 'In Progress'
  evidence_url TEXT,
  evidence_name TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 4. Enable Row Level Security (RLS)
ALTER TABLE public.users ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.policies ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.controls ENABLE ROW LEVEL SECURITY;

-- 5. RLS Helper & User Policies
CREATE OR REPLACE FUNCTION public.requesting_user_id()
RETURNS TEXT AS $$
BEGIN
  RETURN COALESCE(
    NULLIF(current_setting('app.current_user_id', true), ''),
    (auth.jwt() ->> 'sub')
  );
END;
$$ LANGUAGE plpgsql STABLE;

CREATE POLICY "Users view own policies" ON public.policies
  FOR ALL USING (user_id = public.requesting_user_id());
```

